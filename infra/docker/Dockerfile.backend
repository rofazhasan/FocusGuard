# Multi-stage Dockerfile for FocusGuard Go Backend

# Stage 1: Build
FROM golang:1.22-alpine AS builder

WORKDIR /app

# Install build dependencies
RUN apk add --no-cache git gcc musl-dev

# Copy dependency files
COPY backend/go.mod backend/go.sum* ./

RUN go mod download

# Copy source code
COPY backend/ ./

# Build optimized binary
RUN CGO_ENABLED=0 GOOS=linux go build -ldflags="-w -s" -o focusguard-server ./cmd/server

# Stage 2: Runtime
FROM alpine:3.19

WORKDIR /app

RUN apk add --no-cache ca-certificates tzdata curl && \
    addgroup -g 10001 focusguard && \
    adduser -D -u 10001 -G focusguard focusguard

COPY --from=builder /app/focusguard-server .

USER focusguard:focusguard

EXPOSE 8080

HEALTHCHECK --interval=10s --timeout=5s --start-period=5s --retries=3 \
  CMD curl -f http://localhost:8080/ready || exit 1

CMD ["./focusguard-server"]
