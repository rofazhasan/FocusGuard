# ==============================================================================
# FOCUSGUARD PRODUCTION & DEVELOPMENT CONFIGURATION
# ==============================================================================

# Backend Server Configuration
PORT=8080
ENV=production # development | production | test
LOG_LEVEL=info # debug | info | warn | error

# Authentication & Security
JWT_SECRET=super_secret_focusguard_production_key_2026_change_in_prod
JWT_EXPIRATION_HOURS=720 # 30 days
ENCRYPTION_KEY=32_byte_hex_encoded_key_for_db_encryption_here

# Database Configuration (PostgreSQL / SQLite fallback)
# Set DB_TYPE=postgres for production cluster, or DB_TYPE=sqlite for zero-dependency local run
DB_TYPE=sqlite
DB_PATH=backend/focusguard.db

# PostgreSQL (if DB_TYPE=postgres)
DB_HOST=localhost
DB_PORT=5432
DB_USER=focusguard
DB_PASSWORD=focusguard_secret
DB_NAME=focusguard_db
DB_SSLMODE=disable

# CORS & Network
CORS_ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3000,chrome-extension://*
WS_PING_INTERVAL_SEC=30
WS_MAX_CONNECTIONS_PER_USER=20

# Web Command Center
WEB_PORT=3001
API_URL=http://localhost:8080/api/v1
WS_URL=ws://localhost:8080/ws
