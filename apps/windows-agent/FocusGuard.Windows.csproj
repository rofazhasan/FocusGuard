<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>FocusGuard.Windows</RootNamespace>
    <AssemblyName>FocusGuard.Windows</AssemblyName>
    <ApplicationIcon>Resources\focusguard.ico</ApplicationIcon>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <!-- Self-contained single file for easy deployment -->
    <SelfContained>false</SelfContained>
    <Version>1.0.0</Version>
    <Company>FocusGuard</Company>
    <Description>FocusGuard Windows Agent — Consent-based local policy enforcement</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Logging" Version="8.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="7.5.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
    <!-- Newtonsoft.Json for reliable JSON handling -->
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <!-- WebSocket client -->
    <PackageReference Include="Websocket.Client" Version="5.1.1" />
    <!-- SQLite for local offline storage -->
    <PackageReference Include="Microsoft.Data.Sqlite" Version="8.0.0" />
    <!-- QR code generation for pairing UI -->
    <PackageReference Include="QRCoder" Version="1.6.0" />
  </ItemGroup>

</Project>
